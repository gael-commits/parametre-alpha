---
/* Keystroke-dynamics typing model (build-time, zero runtime cost).
   Typing rhythm is a property of letter PAIRS (digraphs), not letters: hand
   alternation is fastest because the second hand pre-positions while the first
   is still moving; a same-finger bigram is slowest because one finger must
   lift, translate and re-press with no overlap possible. Modelling this is what
   separates "a machine revealing characters" from "a person typing".
   Concept + calibration: system/library/motion/keystroke-dynamics-typing.md */

// QWERTY touch-typing fingering. L/R = hand, 1..4 = index..pinky.
const FINGER = {
  q: 'L4', a: 'L4', z: 'L4',
  w: 'L3', s: 'L3', x: 'L3',
  e: 'L2', d: 'L2', c: 'L2',
  r: 'L1', f: 'L1', v: 'L1', t: 'L1', g: 'L1', b: 'L1',
  y: 'R1', h: 'R1', n: 'R1', u: 'R1', j: 'R1', m: 'R1',
  i: 'R2', k: 'R2',
  o: 'R3', l: 'R3',
  p: 'R4',
};

const ROW = {
  q: 0, w: 0, e: 0, r: 0, t: 0, y: 0, u: 0, i: 0, o: 0, p: 0,
  a: 1, s: 1, d: 1, f: 1, g: 1, h: 1, j: 1, k: 1, l: 1,
  z: 2, x: 2, c: 2, v: 2, b: 2, n: 2, m: 2,
};

// Inter-key-interval multipliers per digraph class. These four numbers are the
// only knobs: raise sameFinger for a more pronounced stumble, lower it to smooth.
const MULT = { alternation: 0.75, roll: 1, reach: 1.15, sameFinger: 2 };

const classify = (a, b) => {
  const fa = FINGER[a];
  const fb = FINGER[b];
  if (!fa || !fb) return 'roll';
  if (fa === fb) return 'sameFinger';           // slowest: one finger, two keys
  if (fa[0] !== fb[0]) return 'alternation';    // fastest: hands overlap
  const adjacentFingers = Math.abs(+fa[1] - +fb[1]) === 1;
  return adjacentFingers && ROW[a] === ROW[b] ? 'roll' : 'reach';
};

const typed = (word, start, base) => {
  let t = start;
  return [...word].map((ch, i) => {
    if (i) t += base * MULT[classify(word[i - 1], word[i])];
    return { ch, at: +t.toFixed(4) };
  });
};

const span = (word, base) =>
  [...word].slice(1).reduce((t, ch, i) => t + base * MULT[classify(word[i], ch)], 0);

/* The wordmark timeline is expressed as DURATIONS AND GAPS, not absolute
   timestamps. Retune a typing speed and everything after it is pushed along the
   timeline automatically, with the breaths — and therefore the cadence — intact. */
const HEAD_START = 0.177;
const HEAD_BASE = 0.031185;         // typing pace of "parametre"
const BREATH_BEFORE_COLON = 0.0691; // wordmark lands, then the mark resolves
const BREATH_AFTER_COLON = 0.3;     // the colon's own moment, before "art"
const TAIL_BASE = 0.03;             // typing pace of "art"

const head = typed('parametre', HEAD_START, HEAD_BASE);
const colonAt = +(head[head.length - 1].at + BREATH_BEFORE_COLON).toFixed(4);
const tail = typed('art', +(colonAt + BREATH_AFTER_COLON).toFixed(4), TAIL_BASE);
// The cursor rides in as the next keystroke after the final "t" — same instant,
// so its perceived stutter comes only from the slow head of the S-curve attack.
const cursorAt = tail[tail.length - 1].at;
---
<div class="wordmark" aria-label="parametre:art">
  <span aria-hidden="true">
    {head.map(({ ch, at }) => <span class="wordmark__char" style={`--at:${at}s`}>{ch}</span>)}<span class="wordmark__dot" style={`--at:${colonAt}s`}>:</span>{tail.map(({ ch, at }) => <span class="wordmark__char" style={`--at:${at}s`}>{ch}</span>)}<span class="wordmark__cursor" style={`--at:${cursorAt}s`}>_</span>
  </span>
</div>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-wordmark);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-text);
  }
  .wordmark__char {
    display: inline-block;
  }
  .wordmark__dot {
    display: inline-block;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Beats 1 + 3: each character appears at its modelled keystroke time. */
    .wordmark__char {
      opacity: 0;
      animation: wm-char-in 1ms linear forwards;
      animation-delay: var(--at);
    }
    /* Beat 2: the colon ink-dries in, breathing tempo — the page's one breathing moment */
    .wordmark__dot {
      opacity: 0;
      transform: translateY(-2px);
      animation: wm-colon-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--at) forwards;
    }
    /* Beat 4: underscore cursor, two pulses, entering on the final keystroke */
    .wordmark__cursor {
      opacity: 0;
      animation: wm-cursor-blink 2.5s linear var(--at) forwards;
    }
  }

  /* Outside the media query the cursor never shows (reduced-motion + end state) */
  .wordmark__cursor {
    opacity: 0;
  }

  @keyframes wm-char-in {
    to { opacity: 1; }
  }
  @keyframes wm-colon-in {
    to { opacity: 1; transform: translateY(0); }
  }
  /* Two pulses with envelope asymmetry (fast S-curved attack, 10% longer
     decay on the afterglow curve) separated by a rest: an 80ms humanization-scale hold
     at zero between the envelopes (felt, not seen — de-quantize, not pause) (inter-onset interval > pulse length),
     which phrases the pair as "blink, blink" instead of "blinkblink". */
  @keyframes wm-cursor-blink {
    0% { opacity: 0; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    23.06% { opacity: 1; animation-timing-function: cubic-bezier(0.2, 0, 0, 1); }
    48.45% { opacity: 0; }
    51.55% { opacity: 0; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    74.61% { opacity: 1; animation-timing-function: cubic-bezier(0.2, 0, 0, 1); }
    100% { opacity: 0; }
  }
</style>
