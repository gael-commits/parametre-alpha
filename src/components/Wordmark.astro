---
const head = 'parametre'.split('');
const tail = 'art'.split('');
---
<div class="wordmark" aria-label="parametre:art">
  <span aria-hidden="true">
    {head.map((c, i) => <span class="wordmark__char" style={`--ci:${i}`}>{c}</span>)}<span class="wordmark__dot">:</span>{tail.map((c, i) => <span class="wordmark__char wordmark__char--tail" style={`--ci:${i}`}>{c}</span>)}<span class="wordmark__cursor">_</span>
  </span>
</div>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-wordmark);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-text);
  }
  .wordmark__char {
    display: inline-block;
  }
  .wordmark__dot {
    display: inline-block;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Beat 1: "parametre" types, stepped appearance (no caret, no jitter) */
    .wordmark__char {
      opacity: 0;
      animation: wm-char-in 1ms linear forwards;
      animation-delay: calc(0.2s + var(--ci) * 0.027s);
    }
    /* Beat 2: the colon ink-dries in, breathing tempo — the page's one breathing moment */
    .wordmark__dot {
      opacity: 0;
      transform: translateY(-2px);
      animation: wm-colon-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }
    /* Beat 3: "art" types */
    .wordmark__char--tail {
      animation-delay: calc(0.8s + var(--ci) * 0.03s);
    }
    /* Beat 4: underscore cursor blinks twice (on-off-on-off), slow and even */
    .wordmark__cursor {
      opacity: 0;
      animation: wm-cursor-blink 2.5s linear 0.86s forwards;
    }
  }

  /* Outside the media query the cursor never shows (reduced-motion + end state) */
  .wordmark__cursor {
    opacity: 0;
  }

  @keyframes wm-char-in {
    to { opacity: 1; }
  }
  @keyframes wm-colon-in {
    to { opacity: 1; transform: translateY(0); }
  }
  /* Two pulses with envelope asymmetry (fast S-curved attack, 10% longer
     decay on the afterglow curve) separated by a rest: an 80ms humanization-scale hold
     at zero between the envelopes (felt, not seen — de-quantize, not pause) (inter-onset interval > pulse length),
     which phrases the pair as "blink, blink" instead of "blinkblink". */
  @keyframes wm-cursor-blink {
    0% { opacity: 0; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    23.06% { opacity: 1; animation-timing-function: cubic-bezier(0.2, 0, 0, 1); }
    48.45% { opacity: 0; }
    51.55% { opacity: 0; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    74.61% { opacity: 1; animation-timing-function: cubic-bezier(0.2, 0, 0, 1); }
    100% { opacity: 0; }
  }
</style>
