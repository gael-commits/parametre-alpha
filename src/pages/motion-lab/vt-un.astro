---
// Motion-lab: view-transitions demo, page 1 of 2. The ONLY moving thing here is the
// Astro ClientRouter cross-fade between the two pages; the content itself is still,
// so the transition is judged in isolation. Compare with a hard navigation between
// /home and /secteurs/... (candidate A = none). Sandbox-only, killed at promotion.
import '../../styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>parametre - motion lab - transition 1</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <main class="vt">
      <p class="vt__eyebrow">transition de vue, page 1 sur 2</p>
      <h1 class="vt__headline">Vos clients reviennent, votre maison <span class="vt__accent">grandit</span>.</h1>
      <p class="vt__body">
        Cliquez vers la page 2 : le passage se fait par fondu croisé (candidat B). Le candidat A
        est la navigation actuelle, sans transition : comparez avec un aller-retour entre la page
        d'accueil et une page secteur.
      </p>
      <nav class="vt__nav">
        <a href="/motion-lab/vt-deux" data-vt-nav>Vers la page 2</a>
        <a href="/motion-lab/" data-astro-reload>Retour au laboratoire</a>
      </nav>
      <p class="vt__modes">
        Mode : <a href="/motion-lab/vt-un" data-vt-mode="fondu">fondu croisé</a> ·
        <a href="/motion-lab/vt-un?mode=balayage" data-vt-mode="balayage">balayage encre</a>
      </p>
    </main>
    <script src="../../scripts/vt-mode.ts"></script>
  </body>
</html>

<style is:global>
  /* Mode « balayage » : la nouvelle page balaie l'ancienne de gauche à droite
     (clip-path sur le snapshot de la View Transition), courbe in-out du balayage. */
  html[data-vt='balayage']::view-transition-old(root) {
    animation: none;
  }
  html[data-vt='balayage']::view-transition-new(root) {
    animation: vt-wipe 0.6s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  @keyframes vt-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0% 0 0);
    }
  }
</style>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-paper);
    line-height: var(--leading-body);
    -webkit-font-smoothing: antialiased;
  }
  .vt {
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: var(--space-breath) var(--grid-inset);
  }
  .vt__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-label);
  }
  .vt__headline {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 500;
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
    color: var(--color-ink);
    max-width: var(--measure-hero);
    text-wrap: balance;
  }
  .vt__accent {
    color: var(--color-accent);
  }
  .vt__body {
    margin-top: var(--space-m);
    font-size: var(--text-body-lg);
    line-height: 1.5;
    max-width: 34rem;
  }
  .vt__nav {
    margin-top: var(--space-l);
    display: flex;
    gap: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }
  .vt__nav a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline);
  }
  .vt__nav a:hover {
    border-color: var(--color-ink);
  }
  .vt__modes {
    margin-top: var(--space-l);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-label);
  }
  .vt__modes a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline);
  }
</style>
