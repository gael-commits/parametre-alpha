---
import SplashLayout from '../layouts/SplashLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import ContactForm from '../components/ContactForm.astro';
import { i18n } from '../data/i18n';

const t = i18n.fr;
---
<SplashLayout
  lang={t.lang}
  title={t.title}
  description={t.description}
  alternateHref={t.alternateHref}
  alternateLang={t.alternateLang}
>
  <main class="splash">
    <header class="splash__header">
      <LanguageToggle
        href={t.langToggleHref}
        label={t.langToggleLabel}
        title={t.langToggleTitle}
      />
    </header>

    <div class="splash__body">
      <Wordmark />
      <p class="splash__tagline">{t.tagline.before}<span class="splash__tagline-accent">{t.tagline.accent}</span>{t.tagline.after}<br />{t.tagline.sub}</p>
      <hr class="splash__rule" />
      <p class="splash__status">{t.comingSoon}</p>
      <p class="splash__value-prop">{t.valueProp}</p>
    </div>

    <footer class="splash__footer">
      <span class="splash__contact-label">{t.contactLabel}</span>
      <div class="splash__footer-actions">
        <button class="splash__cta" data-modal-open>{t.ctaButton}</button>
        <a href={t.linkedinUrl} target="_blank" rel="noopener" class="splash__footer-linkedin">{t.linkedinLabel}</a>
      </div>
    </footer>
  </main>

  <ContactForm
    lang={t.lang}
    form={t.form}
    closeLabel={t.closeModal}
    linkedinUrl={t.linkedinUrl}
    linkedinLabel={t.linkedinLabel}
  />
</SplashLayout>
